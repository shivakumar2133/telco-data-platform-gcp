# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- GCP (Phase 0)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
BQ_LOCATION=us-central1
ENV=dev

# --- Local Docker source systems (Phase 1)
# Throwaway passwords for databases that only run on your laptop.
# Cloud-side secrets go in Secret Manager (Phase 2), never in this file.
# SQL Server needs upper + lower + digit + symbol, 8+ characters.
ORACLE_PASSWORD=Telco_Dev_2026
BILLING_DB_PASSWORD=Billing_Dev_2026
MSSQL_SA_PASSWORD=Telco_Dev_2026
POSTGRES_PASSWORD=Telco_Dev_2026
ETL_READER_PASSWORD=Etl_Reader_2026
TICKETS_API_KEY=local-dev-key-change-me
TICKETS_API_URL=http://localhost:8000

# --- Airflow (Phase 4): run `make airflow-env` to generate these
# AIRFLOW_UID=1000
# AIRFLOW_FERNET_KEY=...
# AIRFLOW_JWT_SECRET=...
# AIRFLOW_ADMIN_PASSWORD=...
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   (optional)

# --- Governance (Phase 8): run `make governance-env` after `make tf-apply` to set these
# DATA_STEWARD=user:you@gmail.com
# DBT_POLICY_TAG_EMAIL=projects/<id>/locations/us-central1/taxonomies/<n>/policyTags/<n>
# DBT_POLICY_TAG_PHONE=...
# DBT_POLICY_TAG_NAME=...
# DBT_POLICY_TAG_BIRTH_DATE=...
# DBT_POLICY_TAG_POSTCODE=...
# DBT_POLICY_TAG_RAW_RECORD=...
