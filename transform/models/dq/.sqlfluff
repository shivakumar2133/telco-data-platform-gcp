# These models are SQL generated by Jinja loops over the DQ rule catalogue:
# indentation (LT02) is judged on the template, and the rule relation alias `t`
# is used inside the generated expressions (AL05). Same list as the root plus those two.
[sqlfluff]
exclude_rules = AM04, ST06, RF02, AL03, LT09, ST07, ST09, LT14, RF04, LT02, AL05
